// HHGOA data model. Apply to a fresh TigerGraph catalog.
// The transaction CSV has customer_id but NO card_id or merchant identifier.
// Card-to-transaction edges are created only for explicit case-pack anchors or
// closed-case txn_ids. No account, merchant, or money-transfer edge is inferred.

CREATE VERTEX Customer (PRIMARY_ID id STRING) WITH primary_id_as_attribute="true"
CREATE VERTEX Card (PRIMARY_ID id STRING) WITH primary_id_as_attribute="true"
CREATE VERTEX Transaction (PRIMARY_ID id STRING, customer_id STRING, ts STRING,
  amount DOUBLE, product STRING, channel STRING, risk DOUBLE, card1 STRING,
  card2 STRING, card3 STRING, card4 STRING, card5 STRING, card6 STRING,
  billing_region STRING, billing_country STRING, purchaser_email STRING,
  recipient_email STRING, identity_status STRING, proxy_status STRING,
  match_status STRING, device_type STRING,
  device_profile_id STRING) WITH primary_id_as_attribute="true"
CREATE VERTEX DeviceProfile (PRIMARY_ID id STRING, label STRING, device_info STRING,
  os STRING, browser STRING, screen STRING, specificity INT) WITH primary_id_as_attribute="true"
CREATE VERTEX EmailDomain (PRIMARY_ID id STRING) WITH primary_id_as_attribute="true"
CREATE VERTEX BillingRegion (PRIMARY_ID id STRING) WITH primary_id_as_attribute="true"
CREATE VERTEX ClosedCase (PRIMARY_ID id STRING, customer_id STRING, card_id STRING,
  outcome STRING, pattern STRING, closed_at STRING, exposure DOUBLE,
  notes STRING) WITH primary_id_as_attribute="true"
CREATE VERTEX InvestigationCase (PRIMARY_ID id STRING, status STRING, verdict STRING,
  pattern STRING, probability DOUBLE, summary STRING, answer_json STRING,
  updated_at STRING) WITH primary_id_as_attribute="true"
CREATE VERTEX CaseEvidence (PRIMARY_ID id STRING, claim STRING, source STRING,
  reference STRING, entity_ids_json STRING) WITH primary_id_as_attribute="true"

CREATE DIRECTED EDGE OWNS (FROM Customer, TO Card) WITH REVERSE_EDGE="OWNED_BY"
CREATE DIRECTED EDGE MADE (FROM Customer, TO Transaction) WITH REVERSE_EDGE="MADE_BY"
CREATE DIRECTED EDGE CARD_TX (FROM Card, TO Transaction) WITH REVERSE_EDGE="TX_CARD"
CREATE DIRECTED EDGE FROM_DEVICE (FROM Transaction, TO DeviceProfile) WITH REVERSE_EDGE="DEVICE_OF"
CREATE DIRECTED EDGE PURCHASER_EMAIL (FROM Transaction, TO EmailDomain) WITH REVERSE_EDGE="PURCHASED_WITH"
CREATE DIRECTED EDGE RECIPIENT_EMAIL (FROM Transaction, TO EmailDomain) WITH REVERSE_EDGE="RECEIVED_BY"
CREATE DIRECTED EDGE BILLED_IN (FROM Transaction, TO BillingRegion) WITH REVERSE_EDGE="REGION_TX"
CREATE DIRECTED EDGE CLOSED_CUSTOMER (FROM ClosedCase, TO Customer) WITH REVERSE_EDGE="CUSTOMER_CLOSED_CASE"
CREATE DIRECTED EDGE CLOSED_CARD (FROM ClosedCase, TO Card) WITH REVERSE_EDGE="CARD_CLOSED_CASE"
CREATE DIRECTED EDGE CLOSED_TX (FROM ClosedCase, TO Transaction) WITH REVERSE_EDGE="TX_CLOSED_CASE"
CREATE DIRECTED EDGE CASE_CUSTOMER (FROM InvestigationCase, TO Customer) WITH REVERSE_EDGE="CUSTOMER_CASE"
CREATE DIRECTED EDGE CASE_CARD (FROM InvestigationCase, TO Card) WITH REVERSE_EDGE="CARD_CASE"
CREATE DIRECTED EDGE CASE_TX (FROM InvestigationCase, TO Transaction) WITH REVERSE_EDGE="TX_CASE"
CREATE DIRECTED EDGE CASE_EVIDENCE (FROM InvestigationCase, TO CaseEvidence) WITH REVERSE_EDGE="EVIDENCE_CASE"

CREATE GRAPH HHGOA (*)
